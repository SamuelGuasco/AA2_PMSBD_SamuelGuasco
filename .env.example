# Documento las variables que necesito para el entorno académico local.
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_SERVER=localhost\SQLEXPRESS
DB_DATABASE=TechMindSolutions_AA2
DB_TRUSTED_CONNECTION=yes
DB_ENCRYPT=yes
# Uso esta excepción de certificado únicamente en el desarrollo local.
DB_TRUST_SERVER_CERTIFICATE=yes

# Configuro SMTP con SSL/TLS; completo la contraseña solo en el archivo .env local.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=usuario@example.com
SMTP_PASSWORD=
SMTP_USE_SSL=true

# Completo estos valores en .env con los datos del acceso FTPS, sin compartir credenciales.
FTP_HOST=
FTP_PORT=21
FTP_USER=
FTP_PASSWORD=
FTP_USE_TLS=true

# Configuro el clima sin publicar mi clave real; solicito descripciones en español.
OPENWEATHER_API_KEY=REEMPLAZAR_CON_MI_CLAVE
OPENWEATHER_CITY=Quito,EC
OPENWEATHER_UNITS=metric
OPENWEATHER_LANG=es
